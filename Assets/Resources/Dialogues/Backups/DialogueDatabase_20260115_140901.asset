    - "\uC804\uB825 \uC9C8\uC8FC!! \uBD80\uC2A4\uD130 \uC628 \uCE74\uD53C!!"
    - "\uC2EC\uC7A5\uC774 \uCAC4\uAE43\uD574\uC9C4\uB2E4 \u3137\u3137 \uCE74\uD53C!!"
    - "\uC2A4\uD53C\uB4DC~ \uC2A4\uD53C\uB4DC~ \uB354 \uC62C\uB824 \uCE74\uD53C!!"
    - "\uC774\uB7EC\uB2E4\uAC04 \uD070\uC77C \uB09C\uB2E4 \uCE74\uD53C!! \uBE68\uB9AC\uBE68\uB9AC!!"
    - "\uD55C\uAD6D\uC778\uC758 \uC18D\uB3C4\uB97C \uBCF4\uC5EC\uC918 \uCE74\uD53C!!"
