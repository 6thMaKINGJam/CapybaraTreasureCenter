    IsPersistent: 1
    IsLoop: 0
    LoopInterval: 0
  - Type: 4
    Dialogues:
    - "\uADDC\uCE59\uC744 \uC81C\uB300\uB85C \uC9C0\uCF30\uB294\uC9C0 \uD655\uC778\uD574\uBD10\uCE74\uD53C"
    - "\uBB54\uAC00 \uC774\uC0C1\uD55C\uB370\uCE74\uD53C"
    - "\uC870\uAC74\uC744 \uB2E4\uC2DC \uC77D\uC5B4\uBCF4\uB77C\uCE74\uD53C"
    - "\uADDC\uCE59 \uC704\uBC18\uC774\uB2E4\uCE74\uD53C"
    - "\uC7A0\uAE50 \uD655\uC778 \uC880 \uD574\uBD10\uCE74\uD53C"
    - "\uBB54\uAC00 \uBE60\uB728\uB9B0 \uAC8C \uC788\uB2E4\uCE74\uD53C"
    - "\uB2E4\uC2DC \uD55C\uBC88 \uC0B4\uD3B4\uBCF4\uB77C\uCE74\uD53C"
    - "\uC870\uAC74\uC744 \uB9CC\uC871\uD558\uC9C0 \uBABB\uD588\uB2E4\uCE74\uD53C"
    - "\uADDC\uCE59\uC774 \uC788\uB294 \uC774\uC720\uAC00 \uC788\uB2E4\uCE74\uD53C"
    - "\uAF3C\uAF3C\uD558\uAC8C \uD655\uC778\uD574\uC57C \uD55C\uB2E4\uCE74\uD53C"
    - "\uADDC\uCE59\uC740 \uC9C0\uCF1C\uC57C \uD55C\uB2E4\uCE74\uD53C"
    - "\uAE30\uC900\uC744 \uB9DE\uCDB0\uC57C \uD55C\uB2E4\uCE74\uD53C"
    - "\uC774\uAC74 \uD1B5\uACFC \uBABB\uD55C\uB2E4\uCE74\uD53C"
    IsPersistent: 0
    IsLoop: 0
    LoopInterval: 0
  - Type: 5
    Dialogues:
    - "\uCE74\uD53C? \uAC1C\uC218\uAC00 \uC774\uC0C1\uD558\uB2E4\uCE74\uD53C. \uB0B4
      \uB208\uC740 \uBABB \uC18D\uC778\uB2E4\uCE74\uD53C"
    - "\uAC1C\uC218\uB97C \uB531 \uB9DE\uCDB0\uC57C \uAE30\uBD84\uC774 \uC88B\uC544\uC9C4\uB2E4\uCE74\uD53C"
    - "\uAC1C\uC218\uB97C \uB2E4\uC2DC \uD55C\uBC88 \uC138\uC5B4\uBCFC\uB798\uCE74\uD53C?"
    - "\uC878\uBA74\uC11C \uB2F4\uC740 \uAC74 \uC544\uB2C8\uC9C0\uCE74\uD53C? \uAC1C\uC218\uAC00
      \uD2C0\uB838\uB2E4\uCE74\uD53C!"
    - "\uB2E4 \uBCF4\uACE0 \uC788\uB2E4\uCE74\uD53C. \uAC1C\uC218 \uD2C0\uB838\uB2E4\uCE74\uD53C"
    - "\uC0AC\uACFC\uB9CC\uD07C \uC138\uAE30 \uC26C\uC6B4 \uBCF4\uC11D \uAC1C\uC218\uC778\uB370...
      \uB2E4\uC2DC \uD574\uBCF4\uC790\uCE74\uD53C!"
    - "\uB561! \uBCF4\uC11D \uAC1C\uC218\uAC00 \uC548 \uB9DE\uB294\uB2E4\uCE74\uD53C.
      \uB2E4\uC2DC \uD655\uC778\uD574\uB77C\uCE74\uD53C"
    - "\uC815\uD655\uD55C \uAC1C\uC218\uB9CC\uC774 \uD074\uB9AC\uC5B4\uC758 \uC9C0\uB984\uAE38\uC774\uB2E4\uCE74\uD53C."
    - "\uAC1C\uC218\uB97C \uB9DE\uCDB0\uC640\uB77C\uCE74\uD53C"
    - "\uC0C1\uC790\uAC00 \uC694\uAD6C\uD558\uB294 \uAC1C\uC218\uB97C \uBB34\uC2DC\uD558\uBA74
      \uC548 \uB41C\uB2E4\uCE74\uD53C!"
    - "\uCE74\uD53C... \uB0B4 \uBD80\uD0C1\uC744 \uB4E4\uC5B4\uC8FC\uAE30 \uC2EB\uC740
      \uAC74\uAC00\uCE74\uD53C? \uAC1C\uC218\uAC00 \uD2C0\uB838\uB2E4\uCE74\uD53C"
    - "\uC557! \uBCF4\uC11D\uC774 \uD0C8\uCD9C\uD588\uB098\uCE74\uD53C?"
    - "\uAC1C\uC218 \uB9DE\uCD94\uAE30 \uAC8C\uC784\uC778\uB370 \uAC1C\uC218\uB97C
      \uD2C0\uB9AC\uBA74 \uC5B4\uB5A1\uD558\uB098\uCE74\uD53C!"
    IsPersistent: 1
    IsLoop: 0
    LoopInterval: 0
  - Type: 6
    Dialogues:
    - "\uBCF4\uC11D\uB4E4\uC774 \uC54C\uB85D\uB2EC\uB85D \uBAA8\uC5EC\uC57C \uB354
      \uC608\uC058\uB2E4\uCE74\uD53C"
    - "\uBB34\uC9C0\uAC1C\uCC98\uB7FC \uBAA8\uB4E0 \uC0C9\uC774 \uB2E4 \uB4E4\uC5B4\uAC00\uC57C
      \uC644\uBCBD\uD55C \uC0C1\uC790\uB2E4\uCE74\uD53C!"
    - "\uBE60\uC9C4 \uC0C9\uAE54\uC774 \uC788\uB294 \uAC83 \uAC19\uB2E4\uCE74\uD53C"
    - "\uC0C1\uC790\uAC00 \uD3B8\uC2DD\uC744 \uD558\uBA74 \uC548 \uB41C\uB2E4\uCE74\uD53C"
    - "\uACE8\uACE0\uB8E8 \uB2F4\uB294 \uAC8C \uC774 \uAC8C\uC784\uC758 \uB9E4\uB825\uC774\uB2E4\uCE74\uD53C"
    - "\uCE74\uD53C\uBC14\uB77C\uB294 \uBAA8\uB4E0  \uBCF4\uC11D\uB3C4 \uB2E4 \uC88B\uC544\uD55C\uB2E4\uCE74\uD53C"
    - "\uC0C9\uAE54 \uD558\uB098\uAC00 \uAC00\uCD9C\uD588\uB2E4\uCE74\uD53C!"
    - "\uBB3C\uBA4D \uB54C\uB9AC\uB290\uB77C \uBCF4\uC11D \uC885\uB958\uB97C \uB35C
      \uC13C \uAC70 \uC544\uB2C8\uB0D0\uCE74\uD53C?"
    - "\uC0C1\uC790 \uC548\uC744 \uD654\uB824\uD558\uAC8C \uBC14\uAFD4\uC918\uCE74\uD53C!"
    - "\uCE74\uD53C? \uC0C9\uC774\uBAA8\uC790\uB974\uB2E4\uCE74\uD53C!"
    - "\uC548 \uB41C\uB2E4\uCE74\uD53C! \uC885\uB958\uBCC4\uB85C \uD558\uB098\uC529\uC740
      \uAF2D \uB4E4\uC5B4\uC788\uC5B4\uC57C \uD55C\uB2E4\uCE74\uD53C"
    - "\uBE60\uC9C4 \uBCF4\uC11D \uC885\uB958\uAC00 \uC788\uB2E4\uCE74\uD53C!"
    - "\uBCF4\uC11D \uC885\uB958\uAC00 \uBAA8\uC790\uB780\uB2E4\uCE74\uD53C"
    - "\uC0C1\uC790\uAC00 \uD5C8\uC804\uD558\uB2E4\uACE0 \uC544\uC6B0\uC131\uC774\uB2E4\uCE74\uD53C"
    - "\uBAA8\uB4E0 \uC0C9\uAE54\uC774 \uB2E4 \uD544\uC694\uD558\uB2E4\uCE74\uD53C!"
    - "\uCE74\uD53C! \uC544\uC9C1 \uC548 \uB2F4\uC740 \uBCF4\uC11D\uC774 \uB208\uC5D0
      \uBE64\uD788 \uBCF4\uC778\uB2E4\uCE74\uD53C"
    IsPersistent: 1
    IsLoop: 0
    LoopInterval: 0
  - Type: 9
    Dialogues:
    - "\uBA4B\uC9C0\uB2E4 \uCE74\uD53C..\u3160\u3160"
    - "\uC5ED\uC2DC!! \uCD5C\uACE0\uC57C!!"
    - "\uD06C\uD751(\uB208\uBB3C\uC744 \uC0BC\uD0A4\uBA70\uCE74\uD53C)"
    - "\uC778\uAC04\uC740 \uCD5C\uACE0\uB2E4\uCE74\uD53C"
    - "\uCE74\uD53C\uC640 \uC778\uAC04\uC740 \uD3C9\uC0DD\uCE5C\uAD6C.."
    - "\uCD95\uD558\uD55C\uCE74\uD53C!!!"
    - "\uBE5B\uB09C\uB2E4 \uCE74\uD53C!!"
    - "\uC6B0\uC640~~~ \uB178\uBCA8\uC0C1\uC774\uB77C\uB2C8!!"
    - "\uCE74\uD53C! \uB300\uB2E8\uD558\uB2E4"
    - "\uB178\uBCA8\uC0C1 \uC218\uC0C1\uC790\uD560\uB9CC\uD558\uCE74\uD53C!!"
    - "\uBB58\uD558\uB4E0 \uC798\uD560\uAC70\uB2E4\uCE74\uD53C"
    - "\uC720\uCE94\uB450\uC5D0\uBE0C\uB9AC\uB775\uCE74\uD53C"
    IsPersistent: 0
    IsLoop: 1
    LoopInterval: 0
  - Type: 7
    Dialogues:
    - "\uC544\uC774\uACE0... \uC18D \uD130\uC9C4\uB2E4 \uCE74\uD53C..."
    - "\uAC70\uBD81\uC774\uB791 \uB2EC\uB9AC\uAE30 \uD558\uB0D0 \uCE74\uD53C?!"
    - "\uB108\uBB34 \uB290\uB824!! \uC2DC\uAC04 \uB2E4 \uAC14\uC796\uC544 \uCE74\uD53C!!"
    - "\uC2DC\uAC04 \uAD00\uB9AC \uC2E4\uD328\uB2E4... \uAD7C\uB5B4\uC5B4 \uCE74\uD53C..."
    - "\uD558\uD488 \uB098\uC628\uB2E4... \uC5B8\uC81C\uAE4C\uC9C0 \uD560 \uBED4\uD588\uC5B4?
      \uCE74\uD53C..."
    - "\uB561!! \uC190\uC774 \uB108\uBB34 \uB290\uB9B0 \uAC70 \uC544\uB0D0? \uCE74\uD53C!!"
    - "\uB2EC\uD33D\uC774\uAC00 \uCE5C\uAD6C\uD558\uC790\uACE0 \uD558\uACA0\uB2E4
      \uCE74\uD53C..."
    - "\uC2DC\uAC04\uC740 \uAE30\uB2E4\uB824\uC8FC\uC9C0 \uC54A\uC544!! \uB290\uB824
      \uCE74\uD53C!!"
    - "\uC73C\uC559 \u3160\u3160 \uB291\uC7A5 \uBD80\uB9AC\uB2E4 \uB9DD\uD588\uB2E4
      \uCE74\uD53C!!"
    - "\uADF8 \uC18D\uB3C4\uB85C\uB294 \uC5B4\uB9BC\uB3C4 \uC5C6\uC9C0 \uCE74\uD53C..."
    - "\uD0C0\uC784 \uC624\uBC84!! \uC880 \uB354 \uBE60\uB9BF\uBE60\uB9BF\uD558\uAC8C!!
      \uCE74\uD53C!!"
    - "\uC5EC\uC720 \uBD80\uB9AC\uB2E4 \uD070\uCF54\uB2E4\uCCE4\uB2E4 \uCE74\uD53C...
      \uC154\uD130 \uB2EB\uD614\uC5B4!!"
    - "\uB10C \uB108\uBB34 \uB2A6\uC5C8\uC5B4 \uCE74\uD53C!! \uB2F5\uB2F5\uD574!!"
    - "\uADF8\uB7EC\uAC8C \uBE68\uB9AC \uC880 \uD558\uC9C0 \uCE74\uD53C!!"
    - "\uB098\uBB34\uB298\uBCF4\uAC00 \uBE59\uC758\uD588\uB098... \uCE74\uD53C..."
    - "\uC2DC\uAC04 \uBD80\uC871\uC73C\uB85C \uAC15\uC81C \uC885\uB8CC!! \uB290\uB824!!
      \uCE74\uD53C!!"
    - "\uAD7C\uBCB5\uC774\uB3C4 \uAD6C\uB974\uB294 \uC7AC\uC8FC\uAC00 \uC788\uB2E4\uB358\uB370...
      \uCE74\uD53C...  \uB10C \uADF8\uB0E5 \uAD7C\uBCB5\uC774\uB124.."
    - "\uBC84\uC2A4 \uB5A0\uB0AC\uB2E4... \uC190 \uD754\uB4E4\uC9C0 \uB9C8 \uCE74\uD53C..."
    - "\uC774\uAC74 100% \uC2DC\uAC04 \uBD80\uC871\uC774\uB2E4!! \uC11C\uB458\uB800\uC5B4\uC57C\uC9C0
      \uCE74\uD53C!!"
    - "\uC18D\uB3C4\uAC10\uC774 \uC804\uD600 \uC5C6\uC5B4!! \uB561\uC774\uB2E4 \uCE74\uD53C!!"
    - "\uB0A0\uC774 \uC800\uBB3C\uC5C8\uB2E4... \uB108\uBB34 \uC624\uB798 \uAC78\uB824
      \uCE74\uD53C..."
    - "\uC544\uC27D\uC9C0\uB9CC \uB10C \uB108\uBB34 \uB290\uB838\uC5B4... \uCE74\uD53C..."
    - "\uC2DC\uACC4 \uC880 \uBCF4\uACE0 \uD574!! \uC2DC\uAC04 \uB2E4 \uB410\uC796\uC544
      \uCE74\uD53C!!"
    - "\uB290\uB9BC\uC758 \uBBF8\uD559\uC740 \uC5EC\uAE30\uC120 \uC548 \uD1B5\uD55C\uB2E4
      \uCE74\uD53C!!"
    - "\uCFE8\uCFE8... \uAE30\uB2E4\uB9AC\uB2E4 \uC7A0\uB4E4 \uBED4\uD588\uB2E4 \uCE74\uD53C..."
    - "\uAC04\uBC1C\uC758 \uCC28\uAC00 \uC544\uB2C8\uC57C... \uADF8\uB0E5 \uB2A6\uC5C8\uC5B4
      \uCE74\uD53C!!"
    - "\uC190\uAC00\uB77D \uC6B4\uB3D9 \uC880 \uB354 \uD558\uACE0 \uC640\uB77C \uCE74\uD53C!!"
    - "\uB2E4\uC74C\uC5D4 \uBC30\uB85C \uBE68\uB9AC \uC6C0\uC9C1\uC5EC\uC57C \uD560
